# Copie para .env e preencha. Nunca commitar .env com valores reais.

# Postgres — dev local (docker-compose) ou string do Neon em staging/produção.
DATABASE_URL="postgresql://bruno_financas:bruno_financas@localhost:5432/bruno_financas?schema=public"

# Força o driver adapter do Prisma (server/lib/prisma.ts). Deixe em branco
# para detecção automática pela URL (neon.tech -> neon, senão -> pg).
# DATABASE_DRIVER="pg"

# Better Auth — gere um segredo forte em produção (ex.: openssl rand -hex 32).
BETTER_AUTH_SECRET="troque-este-valor-em-producao"
BETTER_AUTH_URL="http://localhost:3000"

# Protege rotas internas de cron (ex.: geração de insights em lote) — nunca
# use sessão de usuário aí. Gere um valor forte, igual ao BETTER_AUTH_SECRET.
CRON_SECRET="troque-este-valor-em-producao"

# IA — Anthropic Claude (ARCHITECTURE.md, seção D).
ANTHROPIC_API_KEY=""

# Redis (opcional, a partir de V1 — ARCHITECTURE.md, seção B/I).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
