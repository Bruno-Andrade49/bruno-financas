# Copie para .env e preencha. Nunca commitar .env com valores reais.

# Postgres — dev local (docker-compose) ou string do Neon em staging/produção.
DATABASE_URL="postgresql://bruno_financas:bruno_financas@localhost:5432/bruno_financas?schema=public"

# Força o driver adapter do Prisma (server/lib/prisma.ts). Deixe em branco
# para detecção automática pela URL (neon.tech -> neon, senão -> pg).
# DATABASE_DRIVER="pg"

# Better Auth — gere um segredo forte em produção (ex.: openssl rand -hex 32).
BETTER_AUTH_SECRET="troque-este-valor-em-producao"
BETTER_AUTH_URL="http://localhost:3000"

# Protege rotas internas de cron (ex.: geração de insights em lote) — nunca
# use sessão de usuário aí. Gere um valor forte, igual ao BETTER_AUTH_SECRET.
CRON_SECRET="troque-este-valor-em-producao"

# E-mail transacional (recuperação de senha, verificação de e-mail).
# Sem domínio verificado em resend.com/domains, só entrega pro próprio
# e-mail cadastrado na conta Resend — ok pra dev, não pra produção.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bruno Finanças <onboarding@resend.dev>"

# IA (ARCHITECTURE.md, seção D). "gemini" (padrão, gratuito — gere a chave em
# aistudio.google.com, sem cartão) ou "anthropic" (pago, Claude).
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
ANTHROPIC_API_KEY=""

# Redis (opcional, a partir de V1 — ARCHITECTURE.md, seção B/I).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# WhatsApp (Meta Cloud API) — lançar despesas por linguagem natural pelo
# WhatsApp, mesmo "cérebro" do assistente do app. Veja README.md, seção
# "WhatsApp" para o passo a passo de criar o App na Meta e testar com ngrok.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Você escolhe esse valor (qualquer string) e usa o mesmo ao configurar o
# webhook no App Dashboard da Meta.
WHATSAPP_VERIFY_TOKEN=""
# "App Secret" da página Configurações Básicas do App na Meta — usado pra
# validar a assinatura de cada webhook recebido.
WHATSAPP_APP_SECRET=""
# WHATSAPP_API_VERSION="v21.0"
