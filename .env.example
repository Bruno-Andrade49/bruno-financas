# Copie para .env e preencha. Não suba o .env pro git.

# Banco local (docker compose up -d) ou a URL do Neon em produção.
DATABASE_URL="postgresql://bruno_financas:bruno_financas@localhost:5432/bruno_financas?schema=public"

# Opcional: força o driver do Prisma ("pg" ou "neon"). Em branco, detecta pela URL.
# DATABASE_DRIVER="pg"

# Gere valores fortes em produção: openssl rand -hex 32
BETTER_AUTH_SECRET="troque-este-valor-em-producao"
BETTER_AUTH_URL="http://localhost:3000"

# Endereço público do site, sem barra no fim. Usado no SEO (og:image, sitemap...).
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo das rotas de cron. Na Vercel, o cron já envia esse valor sozinho.
CRON_SECRET="troque-este-valor-em-producao"

# E-mail de recuperação de senha e verificação de conta.
# Grátis com Gmail: ative a verificação em 2 etapas e crie uma senha de app em
# https://myaccount.google.com/apppasswords. Depois use SMTP_HOST="smtp.gmail.com".
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Bruno Finanças <seu-email@gmail.com>"

# Alternativa ao SMTP. Sem domínio verificado, o Resend só entrega pro dono da conta.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bruno Finanças <onboarding@resend.dev>"
